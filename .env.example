# Copie para .env e preencha. O .env NUNCA e commitado.

# --- Provedores de texto e imagem (OpenRouter) ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- TTS (o vencedor do teste cego entra aqui; os outros ficam vazios) ---
ELEVENLABS_API_KEY=
FISH_AUDIO_API_KEY=
GEMINI_API_KEY=

# --- Busca web para a checagem de fatos ---
BRAVE_SEARCH_API_KEY=

# --- Orcamento (USD). Ver ADR 0003. ---
MA_BUDGET_SOFT_LIMIT_USD=35
MA_BUDGET_HARD_LIMIT_USD=50
MA_BUDGET_PER_VIDEO_LIMIT_USD=5

# --- Painel ---
MA_PANEL_HOST=127.0.0.1
MA_PANEL_PORT=8765
# Se o painel sair da rede local, isto vira obrigatorio (CLAUDE.md, Seguranca).
MA_PANEL_AUTH_TOKEN=

# --- Caminhos (opcionais; o padrao e relativo a raiz do repositorio) ---
# MA_DATA_DIR=./data
# MA_VIDEOS_DIR=./videos
# MA_BOOKS_DIR=./livros

# Contato no User-Agent das consultas ao Wikimedia Commons (politica da API).
MA_WIKIMEDIA_CONTATO=
